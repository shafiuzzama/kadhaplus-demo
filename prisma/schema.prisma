// KadhaPlus commerce schema (SQLite for local/dev).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  password  String
  role      String    @default("customer") // "customer" | "admin"
  createdAt DateTime  @default(now())
  addresses Address[]
  orders    Order[]
  carts     Cart[]
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  tagline     String
  description String
  category    String
  active      Boolean   @default(true)
  variants    Variant[]
}

model Variant {
  id        String      @id @default(cuid())
  product   Product     @relation(fields: [productId], references: [id])
  productId String
  name      String // e.g. "Single Sachet", "Pack of 5"
  sku       String      @unique
  price     Int // in paise (₹1 = 100)
  mrp       Int
  stock     Int         @default(0)
  sachets   Int         @default(1)
  isDefault Boolean     @default(false)
  cartItems CartItem[]
  orderItems OrderItem[]
}

model Address {
  id        String  @id @default(cuid())
  user      User?   @relation(fields: [userId], references: [id])
  userId    String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  orders    Order[]
}

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique // cookie id for guest/user cart
  user      User?      @relation(fields: [userId], references: [id])
  userId    String?
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String
  variant   Variant @relation(fields: [variantId], references: [id])
  variantId String
  quantity  Int     @default(1)

  @@unique([cartId, variantId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?
  email         String
  address       Address     @relation(fields: [addressId], references: [id])
  addressId     String
  items         OrderItem[]
  subtotal      Int
  shipping      Int         @default(0)
  total         Int
  status        String      @default("pending") // pending|paid|shipped|delivered|cancelled
  paymentMethod String      @default("razorpay")
  paymentStatus String      @default("unpaid") // unpaid|paid|failed
  paymentRef    String?
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id          String  @id @default(cuid())
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  variant     Variant @relation(fields: [variantId], references: [id])
  variantId   String
  name        String
  variantName String
  price       Int
  quantity    Int
}
