# Copy to .env and fill in. The app runs with these defaults out of the box.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional Razorpay keys. Leave blank to use the built-in TEST/MOCK payment flow.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
